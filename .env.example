# Sem chamadas pagas por padrão. Valores permitidos: mock, ollama.
SOLARIA_PROVIDER_MODE=mock
SOLARIA_OLLAMA_BASE_URL=http://localhost:11434
SOLARIA_OLLAMA_MODEL=qwen3:1.7b
SOLARIA_OLLAMA_REVIEW_MODEL=gemma3:1b
# Descarrega após cada chamada para reduzir o uso de RAM.
SOLARIA_OLLAMA_KEEP_ALIVE=0
SOLARIA_REQUEST_TIMEOUT_SECONDS=120
SOLARIA_MAX_INPUT_CHARS=12000
SOLARIA_MAX_OUTPUT_TOKENS=900
SOLARIA_REVIEW_MAX_OUTPUT_TOKENS=160
SOLARIA_MAX_CALLS_PER_RUN=3
SOLARIA_LOCAL_PARALLELISM=1

# Revisão externa opcional: mantenha desativada até verificar o acesso gratuito.
SOLARIA_REVIEW_PROVIDER=ollama
SOLARIA_GEMINI_ENABLED=false
SOLARIA_GEMINI_FREE_TIER_CONFIRMED=false
SOLARIA_GEMINI_MODEL=gemini-3.5-flash-lite
# Configure a chave somente no .env local; nunca a comite.
# SOLARIA_GEMINI_API_KEY=
SOLARIA_GEMINI_DAILY_CALL_LIMIT=10
SOLARIA_GEMINI_DAILY_TOKEN_LIMIT=10000
SOLARIA_MAX_TOTAL_TOKENS_PER_RUN=6000
SOLARIA_DAILY_USAGE_DB_PATH=artifacts/usage.sqlite3

# GitHub Copilot SDK: integração opcional e desativada por padrão.
# Confirme que a conta usa Copilot Free e não permite uso pago adicional.
SOLARIA_COPILOT_ENABLED=false
SOLARIA_COPILOT_FREE_TIER_CONFIRMED=false
SOLARIA_COPILOT_MODEL=auto
SOLARIA_COPILOT_DAILY_CALL_LIMIT=1
SOLARIA_COPILOT_DAILY_TOKEN_LIMIT=4000
SOLARIA_COPILOT_MAX_AI_CREDITS_PER_RUN=1.0
